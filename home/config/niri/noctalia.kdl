layout {

    focus-ring {
        active-color   "#c0c6de"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c0c6de"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c0c6de"
        inactive-color "#8a90a7"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c0c6de80"
    }
}

recent-windows {
    highlight {
        active-color "#c0c6de"
        urgent-color "#ffb4ab"
    }
}
