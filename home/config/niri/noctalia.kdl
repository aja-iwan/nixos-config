layout {

    focus-ring {
        active-color   "#bec5e4"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bec5e4"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bec5e4"
        inactive-color "#9da4c1"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bec5e480"
    }
}

recent-windows {
    highlight {
        active-color "#bec5e4"
        urgent-color "#ffb4ab"
    }
}
