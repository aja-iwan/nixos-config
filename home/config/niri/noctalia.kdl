layout {

    focus-ring {
        active-color   "#c2c4e7"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c2c4e7"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c2c4e7"
        inactive-color "#9a9cbd"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c2c4e780"
    }
}

recent-windows {
    highlight {
        active-color "#c2c4e7"
        urgent-color "#ffb4ab"
    }
}
