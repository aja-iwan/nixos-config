layout {

    focus-ring {
        active-color   "#c6c4dc"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c6c4dc"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c6c4dc"
        inactive-color "#727186"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c6c4dc80"
    }
}

recent-windows {
    highlight {
        active-color "#c6c4dc"
        urgent-color "#ffb4ab"
    }
}
