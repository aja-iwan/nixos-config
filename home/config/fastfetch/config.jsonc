{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/nixos.txt",
    "padding": {
      "top": 1,
      "left": 2
    }
  },

  "display": {
    "separator": " ›  "
  },

  "modules": [
    "break",
    {
      "type": "title",
      "fqdn": false
    },
    "break",
    {
      "type": "os",
      "key": "OS   "
    },
    {
      "type": "kernel",
      "key": "KERN "
    },
    {
      "type": "host",
      "key": "HOST "
    },
    {
      "type": "de",
      "key": "DE   "
    },
    {
      "type": "wm",
      "key": "WM   "
    },
    {
      "type": "shell",
      "key": "SHEL "
    },
    {
      "type": "terminal",
      "key": "TERM "
    },
    {
      "type": "memory",
      "key": "MEM  "
    },
    {
      "type": "swap",
      "key": "SWAP "
    },
    {
      "type": "uptime",
      "key": "TIME "
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}

